{
  "name": "relay-dsh-plugin-codex",
  "version": "0.2.5-rc.1",
  "description": "Codex conversation backend for DeepSeek Harness, powered by the Codex App Server with approvals and DSH tool support.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-codex.git"
  },
  "homepage": "https://github.com/yangbobo2021/relay-dsh-plugin-codex#readme",
  "bugs": {
    "url": "https://github.com/yangbobo2021/relay-dsh-plugin-codex/issues"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": "0.2.2-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prepare:dsh": "bash scripts/link-dsh-development-peers.sh",
    "build": "esbuild host-plugin.js --bundle --format=esm --platform=node --target=node22 --tsconfig-raw='{}' --external:'@deepseek-ai/*' --sourcemap --outfile=lib/host-plugin.js",
    "pretypecheck": "npm run prepare:dsh",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test test/*.test.mjs",
    "test:component": "vitest run test/*.spec.tsx",
    "test": "npm run prepare:dsh && npm run test:unit && npm run test:component",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh.md",
    "docs/images",
    "docs/reliability-spec.md",
    "docs/reliability-acceptance.md",
    "docs/spec/dsh-interaction-bridge.md",
    "docs/spec/execution-presentation.md",
    "scripts/repair-activity-history.mjs",
    "codex-activity-wire.mjs",
    "cordis.patch.yml",
    "presets",
    "lib/host-plugin.js",
    "lib/host-plugin.js.map",
    "docs/dsh-0.1.2-alpha.3.md",
    "dsh-compat.mjs",
    "dsh-client-compat.mjs",
    "dsh-client-compat.d.mts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.8",
    "relay-dsh-plugin-session-import": "github:yangbobo2021/relay-dsh-plugin-session-import#1b789b387e334f65ba364b1ed5fb91c861c5d045",
    "esbuild": "0.28.1"
  }
}
